{
  "name": "nebula-share",
  "productName": "Nebula Share",
  "version": "1.0.0",
  "description": "Peer-to-peer screen sharing for Windows. Share your screen or a single window with anyone running Nebula Share.",
  "main": "src/main.js",
  "author": "mvpfishstick",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.nebulashare.app",
    "productName": "Nebula Share",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/peerjs/dist/peerjs.min.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nebula Share"
    },
    "portable": {
      "artifactName": "NebulaShare-Portable-${version}.exe"
    }
  }
}
